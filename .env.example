# Telegram Bot Token from @BotFather
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Authorized Telegram Numeric User IDs (comma separated or JSON array)
ADMIN_IDS=[347382968, 106629087]

# Database Connection URL (Async SQLite by default, or PostgreSQL)
# SQLite: sqlite+aiosqlite:///./besporman.db
# PostgreSQL: postgresql+asyncpg://user:password@localhost:5432/besporman_db
DATABASE_URL=sqlite+aiosqlite:///./besporman.db

# Environment: development / production
ENVIRONMENT=development
LOG_LEVEL=INFO

# Anti-flood Rate Limiting
RATE_LIMIT_BURST=5
RATE_LIMIT_PERIOD=3.0

# Deployment Delivery Mode (False = Long Polling, True = Webhook)
WEBHOOK_MODE=false
WEBHOOK_URL=https://your-domain.com/webhook
WEBHOOK_PATH=/webhook
WEBAPP_HOST=0.0.0.0
WEBAPP_PORT=8080
